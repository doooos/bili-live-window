{
  "manifest_version": 3,
  "name": "B站直播原生小窗",
  "version": "0.1.1",
  "description": "将 B 站直播原播放器移入置顶小窗，保留画面弹幕和原播放器控件。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "B站直播原生小窗",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://live.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
